{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 FastAPI Backend (Debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "🎨 Streamlit UI (Debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "frontend/app.py",
        "--server.port",
        "8501",
        "--server.address",
        "127.0.0.1"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": true
    },
    {
      "name": "🔧 Serveur MCP (Debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/mcp_server/main.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": true
    },
    {
      "name": "🧪 Pytest (Tous les tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/",
        "-v"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": true
    },
    {
      "name": "📥 Ingérer Manuel Démo (Debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/ingest_sample.py",
      "args": [
        "--sample"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": true
    },
    {
      "name": "📊 Évaluation RAG (Debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evaluation/run_evaluation.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "⚡ MaintiDoc Complet (API + UI)",
      "configurations": [
        "🚀 FastAPI Backend (Debug)",
        "🎨 Streamlit UI (Debug)"
      ]
    }
  ]
}
