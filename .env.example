# =============================================================================
# MaintiDoc — Template des variables d'environnement
# =============================================================================
# Copie ce fichier en ".env" et remplis les valeurs.
# Ce fichier PEUT être commité sur Git (il ne contient pas de vraies valeurs).
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=maintidoc
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=maintidoc_db

# --- MinIO ---
MINIO_ROOT_USER=maintidoc_admin
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- MLflow ---
MLFLOW_BUCKET=maintidoc-mlflow

# --- Ollama (LLM local) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
VLM_MODEL=llava:7b-v1.6-mistral-q4_0

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME
LOG_LEVEL=INFO
